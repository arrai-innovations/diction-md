{
  "name": "@arrai-innovations/diction-md",
  "version": "1.0.0",
  "description": "Deterministic readability and house-style checks for Markdown prose.",
  "type": "module",
  "bin": {
    "diction-md": "bin/diction-md.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "c8 --reporter=html --reporter=json-summary --reporter=text node --test",
    "eslint": "eslint --fix bin src test eslint.config.mjs",
    "prettier": "prettier --write .",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arrai-innovations/diction-md.git"
  },
  "author": "Arrai Innovations Inc. <developers@arrai.com>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/arrai-innovations/diction-md/issues"
  },
  "homepage": "https://github.com/arrai-innovations/diction-md#readme",
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@arrai-innovations/commitlint-config": "^3.0.0",
    "@commitlint/cli": "^21.2.1",
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "doctoc": "^2.5.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6"
  }
}
